# Application
PORT=3001

# JWT
JWT_SECRET=sua-chave-secreta
JWT_EXPIRATION_TIME=86400 # 24 horas em segundos

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repoif

# Frontend
FRONTEND_URL=http://localhost:5173

# Mail (Brevo)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=no-reply@example.com
# URL pública da logo exibida nos e-mails (precisa ser publicamente acessível).
# Use a Public Development URL do R2 (pub-xxxx.r2.dev) ou um Custom Domain.
MAIL_LOGO_URL=url-da-logo-publica

# Cloudflare R2
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
R2_BUCKET=my-bucket
